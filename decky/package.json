    "@decky/ui": "4.16.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "4.65.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "peerDependencyRules": {
